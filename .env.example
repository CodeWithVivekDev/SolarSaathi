# ==========================================
# SolarSaathi Environment Configuration
# ==========================================

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_OFFLINE_DEMO_ADAPTER=true

# Backend (AWS Lambda / Local FastAPI/SAM)
AWS_REGION=ap-south-1
DYNAMODB_TABLE_CACHE=solarsaathi-cache-dev
PVGIS_API_URL=https://re.jrc.ec.europa.eu/api/v5_2
PVGIS_REQUEST_TIMEOUT_SECONDS=10
PVGIS_MAX_RETRIES=3

# Grid Emission Factor (CEA India National Grid Baseline in kg CO2/kWh)
DEFAULT_GRID_EMISSION_FACTOR=0.716
